(version 1)

(rule "U1_no_net_castellation_clearance"
    (constraint clearance (min 0.0mm))
    (condition "A.memberOfFootprint('U1') && A.Type == 'Pad' && !A.Net"))

(rule "U1_no_net_castellation_hole_clearance"
    (constraint hole_clearance (min 0.0mm))
    (condition "A.memberOfFootprint('U1') && A.Type == 'Pad' && !A.Net"))

(rule "buck_section_local_clearance"
    (constraint clearance (min 0.15mm))
    (condition "(A.NetName == 'BB_SW1' || A.NetName == 'BB_SW2' || A.NetName == 'BMS_SYS_CONTACT') && (B.NetName == 'BB_SW1' || B.NetName == 'BB_SW2' || B.NetName == 'BMS_SYS_CONTACT' || B.memberOfFootprint('U2') || B.memberOfFootprint('L1'))"))
