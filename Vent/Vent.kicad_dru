(version 1)

(rule "U1_no_net_castellation_clearance"
    (constraint clearance (min 0.0mm))
    (condition "A.memberOfFootprint('U1') && A.Type == 'Pad' && !A.Net"))

(rule "U1_no_net_castellation_hole_clearance"
    (constraint hole_clearance (min 0.0mm))
    (condition "A.memberOfFootprint('U1') && A.Type == 'Pad' && !A.Net"))
